# The site builds to plain files; the only variables that matter are the ones
# baked in at build time.

# Public origin of the deployed site. Used for canonical URLs, sitemap.xml,
# robots.txt and Open Graph images — a static host cannot read env vars at
# request time, so this has to be set when building for a deploy.
NEXT_PUBLIC_SITE_URL=https://example.com

# Only for hosts that serve the site from a sub-path (GitHub Pages project
# sites): the path, with a leading slash and no trailing one.
# NEXT_PUBLIC_BASE_PATH=/portfolio-template
