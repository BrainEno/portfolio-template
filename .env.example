# ---------------------------------------------------------------------------
# Everything here is OPTIONAL. With no database the site runs in DEMO MODE:
# /admin opens directly on mock data and edits stay in your browser.
# ---------------------------------------------------------------------------

# --- Database (any ONE enables LIVE mode; mock data is then ignored) --------
# Local Postgres from `docker compose up -d db`:
DATABASE_URL=postgresql://portfolio:portfolio@127.0.0.1:5432/portfolio
# Other hosts inject their own variable automatically (Netlify: NETLIFY_DB_URL).
# Managed providers also work: Neon / Supabase / Railway / Render / Vercel Postgres.
# NETLIFY_DB_URL=
# POSTGRES_URL=
# Force TLS off for a private network database (default: on for remote hosts)
# DATABASE_SSL=false

# --- Admin ------------------------------------------------------------------
# Leave empty: the first visit to /admin chooses the password (stored as a salted hash).
ADMIN_PASSWORD=
# Optional: key that signs the admin session cookie (changing it signs everyone out).
ADMIN_SECRET=

# --- SEO --------------------------------------------------------------------
# Public origin used for canonical URLs, sitemap.xml and Open Graph images.
# Netlify / Vercel / Cloudflare Pages / Render are detected automatically.
# NEXT_PUBLIC_SITE_URL=https://example.com

# --- docker-compose only ----------------------------------------------------
# POSTGRES_PASSWORD=
# WEB_PORT=3000
# DOMAIN=example.com
