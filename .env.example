# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any ONE of these enables live (persisted) mode. On Netlify Database the
# NETLIFY_DB_URL variable is injected automatically - nothing to paste.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# NETLIFY_DB_URL=
# NETLIFY_DATABASE_URL=

# ---------------------------------------------------------------------------
# Studio password
# ---------------------------------------------------------------------------
# Leave empty: a freshly connected database asks for a password on first visit
# to /admin (stored as a salted hash). With no database at all the temporary
# password is 123456.
ADMIN_PASSWORD=

# Optional: key used to sign the admin session cookie. Changing it signs
# everyone out. Falls back to a value derived from the admin password.
ADMIN_SECRET=
